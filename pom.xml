<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>de.homelabs</groupId>
    <artifactId>homelabs-mcp</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>homelabs-mcp</name>
    <description>MCP gateway for the homelabs services: one MCP server (Streamable-HTTP) with an OAuth 2.1 resource server and RFC 9728 Protected Resource Metadata, composing its tools from adapter modules</description>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <java.version>25</java.version>
        <!-- The Spring AI line the adapters align their @McpTool annotations with; an
             adapter release and the gateway bump this together. -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- Adapter artifacts. Pinned to what resolves today; CI will pull the released
             versions from GitHub Packages. -->
        <hippocampus-mcp.version>0.1.0</hippocampus-mcp.version>
    </properties>

    <dependencies>
        <!-- MCP server transport, Streamable-HTTP over WebMVC with annotation-based tools. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <!-- OAuth 2.1 resource server (JWT validation) — standard Boot starter, no new
             library family. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- The hippocampus adapter: its @McpTool beans plus the typed REST client that
             forwards the harness token. The gateway depends on adapter artifacts only,
             never on a project's internals. -->
        <dependency>
            <groupId>de.homelabs</groupId>
            <artifactId>hippocampus-mcp</artifactId>
            <version>${hippocampus-mcp.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Runnable gateway: repackage into an executable jar (also what the
                 Dockerfile ships). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Generates spring-configuration-metadata.json for the homelabs.mcp.*
                 namespace (IDE completion). JDK 23+ no longer auto-detects processors on
                 the classpath, so the path is declared explicitly. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- *IT.java classes run under failsafe, not surefire -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
