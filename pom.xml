<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>de.homelabs</groupId>
    <artifactId>homelabs-mcp-spring-boot-starter</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>homelabs-mcp-spring-boot-starter</name>
    <description>Spring Boot starter: MCP server transport (Streamable-HTTP) plus OAuth 2.1 resource server with RFC 9728 Protected Resource Metadata</description>

    <properties>
        <java.version>25</java.version>
        <!-- Same Spring AI line as the first consumer (homelabs-hippocampus, ADR 0003);
             patch upgrades happen together with the consumer, not here. -->
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencies>
        <!-- MCP server transport, Streamable-HTTP over WebMVC with annotation-based tools
             (ADR 0004). Exposed transitively on purpose: a consumer adds this starter and
             does NOT re-declare the transport — the starter IS the transport. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <!-- OAuth 2.1 resource server (JWT validation) — standard Boot starter, no new
             library family; also exposed so consumers need no auth wiring of their own. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Library, not an application: no spring-boot-maven-plugin, no repackaging. -->
            <!-- Generates spring-configuration-metadata.json for the homelabs.mcp.*
                 namespace (IDE completion). JDK 23+ no longer auto-detects processors on
                 the classpath, so the path is declared explicitly; the processor stays
                 off the consumer classpath this way. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- *IT.java classes run under failsafe, not surefire -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
